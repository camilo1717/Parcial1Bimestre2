teFinished":"2025-07-10T01:46:34+0000","dateStarted":"2025-07-10T01:46:34+0000","results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Moda de Summary por mes</h3>\n\n</div>"}]}},{"user":"anonymous","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""}},"keys":[{"name":"Mes","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"Summary","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=328"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=329"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=330"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752111325377_1969395839","id":"paragraph_1752111325377_1969395839","dateCreated":"2025-07-10T01:35:25+0000","status":"FINISHED","text":"import org.apache.spark.sql.functions._\r\n\r\nval dfConFecha = dfClima\r\n  .withColumn(\"Fecha\", to_timestamp($\"Formatted Date\", \"yyyy-MM-dd'T'HH:mm:ss\"))\r\n  .withColumn(\"Mes\", month($\"Fecha\"))\r\n\r\nval resumenMes = dfConFecha\r\n  .groupBy(\"Mes\", \"Summary\")\r\n  .count()\r\n\r\n// Aquí lo que hago es sacar el clima más frecuente (moda)\r\nval window = org.apache.spark.sql.expressions.Window.partitionBy(\"Mes\").orderBy(desc(\"count\"))\r\n\r\nval modaResumenPorMes = resumenMes\r\n  .withColumn(\"rank\", row_number().over(window))\r\n  .filter($\"rank\" === 1)\r\n  .select(\"Mes\", \"Summary\", \"count\")\r\n\r\nz.show(modaResumenPorMes)\r\n","dateUpdated":"2025-07-10T01:53:42+0000","dateFinished":"2025-07-10T01:41:52+0000","dateStarted":"2025-07-10T01:41:52+0000","results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"Mes\tSummary\tcount\n1\tOvercast\t2327\n2\tOvercast\t2217\n3\tMostly Cloudy\t2338\n4\tPartly Cloudy\t3044\n5\tPartly Cloudy\t3331\n6\tPartly Cloudy\t3925\n7\tPartly Cloudy\t4391\n8\tPartly Cloudy\t3912\n9\tPartly Cloudy\t2995\n10\tMostly Cloudy\t2429\n11\tMostly Cloudy\t2476\n12\tMostly Cloudy\t2323\n"},{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mdfConFecha\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [Formatted Date: timestamp, Summary: string ... 12 more fields]\n\u001b[1m\u001b[34mresumenMes\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [Mes: int, Summary: string ... 1 more field]\n\u001b[1m\u001b[34mwindow\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.expressions.WindowSpec\u001b[0m = org.apache.spark.sql.expressions.WindowSpec@1f96c965\n\u001b[1m\u001b[34mmodaResumenPorMes\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m = [Mes: int, Summary: string ... 1 more field]\n"}]},"focus":false},{"user":"anonymous","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752111712011_1694262532","id":"paragraph_1752111712011_1694262532","dateCreated":"2025-07-10T01:41:52+0000","status":"FINISHED","text":"%md\r\n### Velocidad promedio del viento por hora del día","dateUpdated":"2025-07-10T01:55:46+0000","dateFinished":"2025-07-10T01:55:46+0000","dateStarted":"2025-07-10T01:55:46+0000","results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h3>Velocidad promedio del viento por hora del día</h3>\n\n</div>"}]},"focus":false},{"text":"import org.apache.spark.sql.functions._\n\nval dfConHora = dfClima\n  .withColumn(\"timestamp\", to_timestamp(col(\"Formatted Date\")))\n  .withColumn(\"hora\", hour(col(\"timestamp\")))\n\nval vientoPorHora = dfConHora.groupBy(\"hora\")\n  .agg(avg(\"Wind Speed (km/h)\").alias(\"velocidad_promedio\"))\n  .orderBy(\"hora\")\n\nz.show(vientoPorHora)\n","user":"anonymous","dateUpdated":"2025-07-10T01:56:47+0000","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=336"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=337"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752112546143_1696307053","id":"paragraph_1752112546143_1696307053","dateCreated":"2025-07-10T01:55:46+0000","status":"FINISHED","focus":false,"dateFinished":"2025-07-10T01:56:47+0000","dateStarted":"2025-07-10T01:56:47+0000","results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"hora\tvelocidad_promedio\n0\t8.672057839721273\n1\t9.040268176163256\n2\t9.064271958198592\n3\t8.983359343120174\n4\t9.28819375466538\n5\t9.666790121920878\n6\t10.291100771336176\n7\t11.613852575267474\n8\t12.535434361781506\n9\t12.828931873600403\n10\t13.568979049514827\n11\t13.78661147051509\n12\t13.37108805673053\n13\t13.655948693704875\n14\t13.21559226175667\n15\t11.9866603135108\n16\t11.404232097536708\n17\t10.363929335655653\n18\t9.414638243344099\n19\t9.547764692709642\n20\t9.449714530977918\n21\t9.240550734013421\n22\t9.291667421602797\n23\t9.172408013937284\n"},{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mdfConHora\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.DataFrame\u001b[0m